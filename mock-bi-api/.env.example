# Fake Oracle Simphony BI host (port 3006)
PORT=3006

# Sign-in values Integration Manager should save on Settings
MOCK_USERNAME=mockuser
MOCK_PASSWORD=mockpass
MOCK_ORG=DEMOORG
MOCK_CLIENT_ID=mock-client
MOCK_JWT_SECRET=change-me-in-local-env

# Same Postgres database as Integration Manager (warehouse + jobui_ tables stay separate)
# Leave blank to inherit from the repo-root .env
PGHOST=localhost
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Oracle Simphony BI / Reporting and Analytics
# Copy to .env and fill in values from Administration > System > API Accounts.

# Authentication Server URL (OIDC). Example: https://auth.example.com
AUTH_HOST=

# Application Server URL (BI data APIs). Example: https://myorg.oracledocs.com
APP_HOST=

# OAuth client ID from the API account dialog
CLIENT_ID=

# BI API account credentials (not a Reporting and Analytics UI login)
API_USERNAME=
API_PASSWORD=

# Organization short name used on the OIDC sign-in form
ORG_NAME=

# Enterprise short name used in /bi/v1/{orgIdentifier}/... paths
# Defaults to ORG_NAME when left blank.
ORG_IDENTIFIER=

# Optional. Force one business date (YYYY-MM-DD) for every location.
# When blank, each location uses getLatestBusinessDate.
BUS_DT=

# Local Postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Next.js (dev/start scripts also hardcode -p 3005)
PORT=3005

# Optional local mock host (see mock-bi-api/). Set AUTH_HOST and APP_HOST
# to http://localhost:3006 to point Integration Manager at the fake API.
